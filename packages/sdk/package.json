{
  "name": "@agent-hub/sdk",
  "version": "1.0.0",
  "description": "Agent Hub SDK — permission checking, telemetry, key management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode-plugin": {
      "types": "./dist/plugins/opencode-plugin.d.ts",
      "import": "./dist/plugins/opencode-plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "@types/node": "^25.9.3"
  }
}
