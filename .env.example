# Database
DATABASE_URL="postgresql://agenthub:agenthub@localhost:5432/agenthub"

# Auth JWT secret (setup script auto-generates this)
JWT_SECRET="please-run-setup-script"

# AES-256-GCM master key, 32 bytes in hex (setup script auto-generates this)
KEY_ENCRYPTION_KEY="please-run-setup-script"

# Frontend API URL (used by SWR hooks)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Comma-separated allowed CORS origins (e.g. http://localhost:3000,https://app.agent-hub.dev)
# Use "*" to allow all origins (development only)
ALLOWED_ORIGINS=*

# Cron job authentication secret (required for /api/cron/* endpoints)
# Vercel Cron calls these endpoints with `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Telemetry log retention in days (used by /api/cron/cleanup-telemetry)
# Default: 90 days. Aggregated rollups (hourly/daily) are kept indefinitely.
RETENTION_DAYS=90
